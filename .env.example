PORT=3000
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/database?sslmode=require
# Prefer the Vercel integration's OIDC auth in deployment. BLOB_READ_WRITE_TOKEN is the fallback.
BLOB_STORE_ID=store_placeholder
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production
NODE_ENV=development