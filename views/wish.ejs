<%- include('partials/header') %>
<main class="form-page"><a class="back-link" href="/">← back to Kessy's day</a><section class="wish-form-wrap"><div class="form-heading"><p class="eyebrow neon-text">the guestbook / open channel</p><h1>Leave a little<br><em>light here.</em></h1><p>Your words will join the constellation.</p></div><div class="form-panel"><% if (success) { %><div class="success-state"><div class="success-mark">✦</div><p class="eyebrow neon-text">message received</p><h2>It is glowing<br>with the others.</h2><a class="text-link" href="/#wishes">see the guestbook →</a></div><% } else { %><form method="post" action="/wish"><label for="name">your name</label><input id="name" name="name" value="<%= values.name || '' %>" maxlength="60" required placeholder="Who is sending the light?"><label for="message">your message</label><textarea id="message" name="message" maxlength="300" required placeholder="Tell Kessy something she should carry with her..."><%= values.message || '' %></textarea><p class="form-hint">300 characters, give or take a little magic.</p><% if (error) { %><p class="form-error"><%= error %></p><% } %><button class="neon-button submit-button" type="submit">send the wish <span>↗</span></button></form><% } %></div></section></main><%- include('partials/footer') %>
