<%- include('partials/header') %><main class="admin-shell"><aside class="admin-sidebar"><a class="wordmark" href="/">KESSY<span> / 26</span></a><p class="eyebrow">control room</p><nav><a class="active" href="/admin">overview</a><a href="#wishes">wishes</a><a href="#gallery">gallery</a><a href="#visitors">visitors</a></nav><form method="post" action="/admin/logout"><button class="quiet-button" type="submit">sign out</button></form></aside><section class="admin-content"><div class="admin-title"><div><p class="eyebrow neon-text">good morning, admin</p><h1>The constellation<br><em>at a glance.</em></h1></div><span class="status-dot">live</span></div><div class="stat-row"><div><span class="mono">total wishes</span><strong><%= wishes.length %></strong></div><div><span class="mono">visitors</span><strong><%= visitors.length %></strong></div><div><span class="mono">published cards</span><strong><%= gallery.length %></strong></div></div><section class="admin-panel" id="gallery"><div class="panel-head"><div><p class="eyebrow">gallery / add memory</p><h2>Publish a keepsake</h2></div></div><form class="upload-form" method="post" action="/admin/gallery" enctype="multipart/form-data"><input name="title" placeholder="Card title" required><input name="alt" placeholder="Describe the image for screen readers" required><select name="template"><% templates.forEach(template => { %><option value="<%= template.id %>"><%= template.name %></option><% }) %></select><input type="file" name="image" accept="image/jpeg,image/png,image/webp"><button class="neon-button" type="submit">publish <span>+</span></button></form><div class="admin-gallery"><% gallery.forEach(item => { %><div class="admin-gallery-item"><img src="<%= item.image %>" alt="<%= item.alt %>"><div><strong><%= item.title %></strong><span class="mono"><%= item.template %></span></div><form method="post" action="/admin/gallery/<%= item.id %>/delete"><button class="icon-button" aria-label="Delete <%= item.title %>" type="submit">×</button></form></div><% }) %></div></section><section class="admin-panel" id="wishes"><div class="panel-head"><div><p class="eyebrow">guestbook / moderation</p><h2>Recent wishes</h2></div></div><div class="wish-table"><% wishes.slice(0, 8).forEach(wish => { %><div class="table-row"><div><strong><%= wish.name %></strong><p><%= wish.message %></p></div><time class="mono"><%= new Date(wish.createdAt).toLocaleDateString() %></time><form method="post" action="/admin/wishes/<%= wish.id %>/delete"><button class="icon-button" aria-label="Delete wish from <%= wish.name %>" type="submit">×</button></form></div><% }) %><% if (!wishes.length) { %><p class="muted">No wishes yet. The channel is quiet.</p><% } %></div></section><section class="admin-panel" id="visitors"><div class="panel-head"><div><p class="eyebrow">people / gathered</p><h2>Visitors</h2></div></div><div class="visitor-list"><% visitors.forEach(visitor => { %><span><%= visitor.name %><small class="mono"><%= new Date(visitor.createdAt).toLocaleDateString() %></small></span><% }) %></div></section></section></main><%- include('partials/footer') %>
