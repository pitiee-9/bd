<%- include('partials/header') %>
<header class="topbar"><a class="wordmark" href="/">KESSY<span> / 26</span></a><nav><a href="#gallery">gallery</a><a href="#wishes">wishes</a><a class="nav-cta" href="/wish">leave a wish <span>↗</span></a></nav></header>
<main>
  <div class="petal-field" aria-hidden="true"></div>
  <section class="hero" id="top"><div class="hero-copy"><p class="eyebrow">A small constellation, gathered for</p><h1>Kessy<span>'s</span><br><em>next chapter.</em></h1><div class="hero-foot"><p>The countdown is on!<br>Her day is almost here!</p><a class="circle-link" href="#gallery" aria-label="Scroll to gallery">↓</a></div></div><aside class="countdown-card" aria-label="Countdown to Kessy's birthday"><p class="eyebrow rose-text">the moment arrives in</p><div class="countdown" data-countdown-target="2026-08-24T00:00:00"><div><strong data-unit="days">00</strong><span>days</span></div><b>:</b><div><strong data-unit="hours">00</strong><span>hours</span></div><b>:</b><div><strong data-unit="minutes">00</strong><span>minutes</span></div><b>:</b><div><strong data-unit="seconds">00</strong><span>seconds</span></div></div></aside></section>
  <section class="gallery-section" id="gallery"><div class="section-intro"><div><p class="eyebrow rose-text">01 / the keepsakes</p><h2>Little pieces<br><em>of joy.</em></h2></div><p class="intro-copy">A scrapbook in motion, from everyone<br>who is lucky enough to know you.</p></div><div class="gallery-grid"><% gallery.forEach((item, index) => { %><article class="gallery-tile tile-<%= index %>"><div class="tile-image"><img src="<%= item.image %>" alt="<%= item.alt %>" loading="lazy"></div><div class="tile-meta"><span><%= item.title %></span><span class="mono">0<%= index + 1 %></span></div></article><% }) %></div></section>
  <section class="bridge" aria-hidden="true"></section>
  <section class="wishes-section" id="wishes"><div class="wish-glow" aria-hidden="true"></div><div class="wishes-heading"><div><p class="eyebrow neon-text">02 / the guestbook</p><h2>Messages from<br><em>your people.</em></h2></div><a class="neon-button" href="/wish">add your voice <span>+</span></a></div><div class="wish-grid"><% wishes.slice(0, 6).forEach((wish) => { %><article class="wish-note"><p>“<%= wish.message %>”</p><footer><strong><%= wish.name %></strong><time><%= new Date(wish.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></time></footer></article><% }) %></div></section>
</main><%- include('partials/footer') %>
